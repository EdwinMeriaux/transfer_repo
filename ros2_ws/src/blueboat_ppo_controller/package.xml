<?xml version="1.0"?>
<package format="3">
  <name>blueboat_ppo_controller</name>
  <version>0.1.0</version>
  <description>Verified BlueBoat PPO inference with shadow-first MAVROS integration.</description>
  <maintainer email="edwinmeriaux@users.noreply.github.com">Edwin Meriaux</maintainer>
  <license>LicenseRef-See-Provenance</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
